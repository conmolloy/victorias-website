{
  "name": "victoria-adler-website",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint . && stylelint \"**/*.{css,astro}\"",
    "lint:fix": "eslint . --fix && stylelint \"**/*.{css,astro}\" --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run tests/unit",
    "test:watch": "vitest tests/unit",
    "test:dist": "vitest run tests/dist",
    "test:e2e": "playwright test",
    "verify": "npm run format:check && npm run lint && npm test && npm run build && npm run test:dist && npm run test:e2e"
  },
  "dependencies": {
    "astro": "7.4.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "globals": "17.13.0",
    "postcss-html": "2.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "stylelint": "17.16.0",
    "stylelint-config-html": "2.0.0",
    "stylelint-config-recommended": "18.0.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
