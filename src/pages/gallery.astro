---
/**
 * Gallery. All content comes from src/content/gallery.yaml – to add a show,
 * photos, a recording or a video, edit that file (README: "How to update the
 * site"); this file is only the layout.
 */
import { getEntry } from "astro:content";
import AudioClip from "../components/gallery/AudioClip.astro";
import GalleryPhoto from "../components/gallery/GalleryPhoto.astro";
import Lightbox from "../components/Lightbox.astro";
import Production from "../components/gallery/Production.astro";
import VideoPreview from "../components/gallery/VideoPreview.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const { data } = (await getEntry("gallery", "gallery"))!;
const { productions } = data;

/** split a list into rows of `size` */
const rows = <T,>(items: T[], size: number): T[][] =>
  Array.from({ length: Math.ceil(items.length / size) }, (_, i) =>
    items.slice(i * size, (i + 1) * size),
  );
const miscRows = rows(data.misc, 3);
---

<BaseLayout
  title="Gallery – Victoria Adler"
  description="Stage photos of Victoria Adler in Macbeth, Treasure Island, Robin Hood and more, plus dance, singing, voice reels and her stage combat certificates."
  path="/gallery"
  preloads={[
    "cabin-700-latin.woff2",
    "source-sans-3-latin.woff2",
    "roboto-400-latin.woff2",
  ]}
>
  <div class="header-container">
    <section>
      <section class="projects-clean dark">
        <div class="container">
          <div class="col">
            <nav class="gallery-nav" aria-label="Gallery sections">
              <a class="js-scroll-trigger galbtn" href="#acting">
                Acting
              </a>
              <a class="js-scroll-trigger galbtn" href="#Dance-section">
                Dance
              </a>
              <a class="js-scroll-trigger galbtn" href="#singing-section">
                Singing
              </a>
              <a class="js-scroll-trigger galbtn" href="#video-section">
                Videos
              </a>
              <a class="js-scroll-trigger galbtn" href="#audio-section">
                Audio
              </a>
              <a class="js-scroll-trigger galbtn" href="#certificate-section">
                Certificates
              </a>
            </nav>
            <h2 id="acting" class="text-center">
              Acting
            </h2>
          </div>

          {/* every show and section the same width */}
          <div class="container">
            <div class="container">
              {productions.map((production, i) => (
                <Production
                  production={production}
                  eager={i === 0}
                  last={i === productions.length - 1}
                />
              ))}

              <div class="row header-new">
                <div class="intro">
                  <h1 id="acting-misc" class="text-center">
                    MISC
                  </h1>
                </div>
              </div>
              {miscRows.map((row, i) => (
                <div
                  class:list={["row", { projects: i === miscRows.length - 1 }]}
                >
                  {row.map((photo) => (
                    <div class="col">
                      <GalleryPhoto photo={photo} kind="dance" />
                    </div>
                  ))}
                </div>
              ))}
            </div>

            <div class="container">
              <div class="row header-new">
                <div class="intro">
                  <h1 id="Dance-section" class="text-center">
                    Dance
                  </h1>
                </div>
              </div>
              {rows(data.dance, 3).map((row) => (
                <div class="row">
                  {row.map((photo) => (
                    <div class="col">
                      <GalleryPhoto photo={photo} kind="dance" />
                    </div>
                  ))}
                </div>
              ))}
            </div>
            <br />

            <div class="container">
              <div class="row intro">
                <h1 id="audio-section" class="text-center">
                  Audio
                </h1>
              </div>
              {rows(data.voice_reels, 2).map((row) => (
                <div class="row">
                  {row.map((clip) => (
                    <AudioClip clip={clip} />
                  ))}
                </div>
              ))}
            </div>

            <div class="container">
              <div class="row header-new">
                <div class="intro">
                  <h1 id="singing-section" class="text-center">
                    Singing
                  </h1>
                </div>
              </div>
              {rows(data.songs, 2).map((row) => (
                <div class="row">
                  {row.map((clip) => (
                    <AudioClip clip={clip} />
                  ))}
                </div>
              ))}

              <div class="row header-new">
                <div class="intro">
                  <h1 id="video-section" class="text-center">
                    Video
                  </h1>
                </div>
              </div>
              {data.video_rows.map((row) => (
                <div class="row">
                  {row.videos.map((video) => (
                    <VideoPreview video={video} />
                  ))}
                </div>
              ))}
            </div>

            <div class="container">
              <div class="row intro">
                <div class="col">
                  <h1 id="certificate-section" class="text-center">
                    Certificates
                  </h1>
                </div>
              </div>
              <div class="row">
                {data.certificates.map((column) => (
                  <div class="col">
                    {column.photos.map((photo) => (
                      <GalleryPhoto photo={photo} kind="certificate" />
                    ))}
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>
    </section>
  </div>
  <Lightbox />
</BaseLayout>
