---
/**
 * Gallery. All content comes from src/content/gallery.yaml – to add a show,
 * photos, a recording or a video, edit that file (README: "How to update the
 * site"); this file is only the layout.
 */
import { getEntry } from "astro:content";
import AudioClip from "../components/gallery/AudioClip.astro";
import Lightbox from "../components/Lightbox.astro";
import ShowCard from "../components/gallery/ShowCard.astro";
import VideoPreview from "../components/gallery/VideoPreview.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { CATEGORIES, categorySlug, galleryCards } from "../lib/gallery";

const { data } = (await getEntry("gallery", "gallery"))!;
// one cover card per show, plus misc, dance and certificates (lib/gallery.ts)
const cards = galleryCards(data);
// filter buttons only for the categories that have cards
const categories = CATEGORIES.filter((c) =>
  cards.some((card) => card.category === c),
);

/** split a list into rows of `size` */
const rows = <T,>(items: T[], size: number): T[][] =>
  Array.from({ length: Math.ceil(items.length / size) }, (_, i) =>
    items.slice(i * size, (i + 1) * size),
  );
---

<BaseLayout
  title="Gallery – Victoria Adler"
  description="Stage photos of Victoria Adler in Macbeth, Treasure Island, Robin Hood and more, plus dance, singing, voice reels and her stage combat certificates."
  path="/gallery"
  preloads={[
    "cabin-700-latin.woff2",
    "source-sans-3-latin.woff2",
    "roboto-400-latin.woff2",
  ]}
>
  <div class="header-container">
    <section>
      <section class="projects-clean dark">
        <div class="container">
          <div class="col">
            <nav class="gallery-nav" aria-label="Gallery sections">
              <a class="js-scroll-trigger galbtn" href="#photos">
                Photos
              </a>
              <a class="js-scroll-trigger galbtn" href="#singing-section">
                Singing
              </a>
              <a class="js-scroll-trigger galbtn" href="#video-section">
                Videos
              </a>
              <a class="js-scroll-trigger galbtn" href="#audio-section">
                Audio
              </a>
            </nav>
            <h2 id="photos" class="text-center">
              Photos
            </h2>
          </div>

          {/* every show and section the same width */}
          <div class="container">
            <div class="container">
              {/* filters: #theatre etc. in the address, so a filtered
                  gallery can be shared (script below) */}
              <div
                class="show-filters"
                role="group"
                aria-label="Show photos of"
              >
                <button
                  type="button"
                  class="show-filter"
                  data-filter="all"
                  aria-pressed="true"
                >
                  All
                </button>
                {categories.map((category) => (
                  <button
                    type="button"
                    class="show-filter"
                    data-filter={categorySlug(category)}
                    aria-pressed="false"
                  >
                    {category}
                  </button>
                ))}
              </div>
              <div class="show-grid">
                {cards.map((card, i) => (
                  <ShowCard card={card} index={i} eager={i < 3} />
                ))}
              </div>
            </div>
            <br />

            <div class="container">
              <div class="row intro">
                <h1 id="audio-section" class="text-center">
                  Audio
                </h1>
              </div>
              {rows(data.voice_reels, 2).map((row) => (
                <div class="row">
                  {row.map((clip) => (
                    <AudioClip clip={clip} />
                  ))}
                </div>
              ))}
            </div>

            <div class="container">
              <div class="row header-new">
                <div class="intro">
                  <h1 id="singing-section" class="text-center">
                    Singing
                  </h1>
                </div>
              </div>
              {rows(data.songs, 2).map((row) => (
                <div class="row">
                  {row.map((clip) => (
                    <AudioClip clip={clip} />
                  ))}
                </div>
              ))}

              <div class="row header-new">
                <div class="intro">
                  <h1 id="video-section" class="text-center">
                    Video
                  </h1>
                </div>
              </div>
              {data.video_rows.map((row) => (
                <div class="row">
                  {row.videos.map((video) => (
                    <VideoPreview video={video} />
                  ))}
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    </section>
  </div>
  <Lightbox />
</BaseLayout>

<script>
  // Filter buttons: show only the cards of one category (data-category);
  // the choice is kept in the address (#theatre, #dance, #stage-combat) so
  // it can be shared, and read from it when the page opens.
  const buttons = [
    ...document.querySelectorAll<HTMLButtonElement>("button.show-filter"),
  ];
  const cards = [...document.querySelectorAll<HTMLElement>(".show-card")];

  function apply(filter: string) {
    if (!buttons.some((b) => b.dataset.filter === filter)) filter = "all";
    for (const b of buttons)
      b.setAttribute("aria-pressed", String(b.dataset.filter === filter));
    for (const card of cards)
      card.hidden = filter !== "all" && card.dataset.category !== filter;
  }

  for (const button of buttons)
    button.addEventListener("click", () => {
      const filter = button.dataset.filter!;
      apply(filter);
      const url = new URL(location.href);
      url.hash = filter === "all" ? "" : filter;
      history.replaceState(history.state, "", url);
    });
  apply(location.hash.slice(1));
  // a link to another filter, or Back/Forward
  addEventListener("hashchange", () => apply(location.hash.slice(1)));
</script>
