---
import BaseLayout from "../layouts/BaseLayout.astro";
import Contact from "../components/Contact.astro";
import PersonSchema from "../components/PersonSchema.astro";
import ReviewCard from "../components/reviews/ReviewCard.astro";
import { getEntry } from "astro:content";
import { paragraphs, publicAsset } from "../lib/media";
import { caption, reviewRows } from "../lib/reviews";

// tagline, photo, about text and contact details: src/content/home.yaml
const home = (await getEntry("home", "home"))!.data;
// reviews marked `home: true` in src/content/reviews.yaml
const { press } = (await getEntry("reviews", "reviews"))!.data;
const homeReviews = reviewRows(press.filter((review) => review.home));
const bio = paragraphs(home.bio);
---

<BaseLayout
  title="Victoria Adler – Actor"
  description="Swedish actor based in London, trained at Stockholm Art School and the Kogan Academy of Dramatic Arts, with a background in stage combat, archery and dance."
  path="/"
  ogType="profile"
  preloads={[
    "lora-latin.woff2",
    "cabin-700-latin.woff2",
    "roboto-400-latin.woff2",
  ]}
  outfit
  brandHref="#"
  bodyId="page-top"
>
  <PersonSchema slot="head" />
  <div class="header-container">
    <div class="video-container">
      <video
        class="responsive-video"
        preload="auto"
        autoplay
        loop
        muted
        playsinline
        poster="assets/video/vid 1.webp"
      >
        <source src="assets/video/12-2024-header-1920.mp4" type="video/mp4" />
      </video>
      <div class="scroll-down-arrow">
        <i class="fa fa-arrow-down"></i>
      </div>
    </div>
  </div>

  <section class="text-center content-section" id="about">
    <h1>
      <b>Victoria Adler</b>
    </h1>
    <h3 class="tagline">{home.tagline}</h3>
    {homeReviews.map((row) => (
      <div class="row">
        {row.map((review) => (
          <div class="col-md">
            <ReviewCard
              quote={review.quote}
              blankLines={review.blank_lines}
              caption={caption(review)}
              link={review.link}
            />
          </div>
        ))}
      </div>
    ))}
    <div class="row">
      <div class="col-sm">
        <img
          class="headshot"
          alt={home.photo.alt}
          src={publicAsset(home.photo.file)}
        />

        <br />
        <br />
        <!-- <div class="row">
                <div class="col-sm ">
                    <div class="card mx-auto" style="width: 18rem; color: black;">
                        <img loading="lazy" decoding="async" class="card-img-top" src="assets/img/ticket_pic/chrismas_charol.webp" alt="Card image cap">
                        <div class="card-body">
                            <h5 class="card-title">A Christmas Carol</h5>
                            <a href="https://www.ticketsource.co.uk/shadowroad" class="btn btn-review">Tickets</a>
                        </div>
                    </div>
                </div>
               <div class="col-sm ">
                    <div class="card mx-auto" style="width: 18rem; color: black;">
                        <img loading="lazy" decoding="async" class="card-img-top" src="assets/img/ticket_pic/2023MACBETJ_AYK.webp" alt="Card image cap">
                        <div class="card-body">
                            <h5 class="card-title">Macbeth</h5>
                            <a href="https://tickets.edfringe.com/whats-on/macbeth-sleep-no-more" class="btn btn-review">Tickets</a>
                        </div>
                    </div>
                </div> -->
        <!-- </div>   -->
      </div>
      <div class="col-sm text-main order-sm-first">
        <p>
          <br />
          {bio.map((lines, i) => (
            <>
              {i > 0 && (
                <>
                  <br />
                  <br />
                </>
              )}
              {lines.map((line, j) => (
                <>
                  {j > 0 && <br />}
                  {line}
                </>
              ))}
            </>
          ))}
        </p>
      </div>
    </div>
  </section>

  <Contact phone={home.contact.phone} email={home.contact.email} />
</BaseLayout>
