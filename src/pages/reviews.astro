---
/**
 * Reviews. All quotes come from src/content/reviews.yaml – to add one, edit
 * that file (README: "How to update the site"); this file is only the layout.
 */
import { getEntry } from "astro:content";
import ReviewCard from "../components/reviews/ReviewCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { caption, reviewRows } from "../lib/reviews";

const { press, coaching_heading, coaching } = (await getEntry(
  "reviews",
  "reviews",
))!.data;
const rows = reviewRows(press);
const half = Math.ceil(coaching.length / 2);
const coachingColumns = [coaching.slice(0, half), coaching.slice(half)];
---

<BaseLayout
  title="Reviews – Victoria Adler"
  description="Press reviews of Victoria Adler in Macbeth: Sleep No More (Edinburgh Fringe 2023 and 2024) and Treasure Island, plus reviews of her archery coaching."
  path="/reviews"
  preloads={[
    "lora-latin.woff2",
    "lora-italic-latin.woff2",
    "roboto-400-latin.woff2",
  ]}
  siteBase
  brandHref="#"
  bodyStyle="padding-top: 100px"
>
  <section class="text-center content-section">
    <h1 style="margin-bottom: 4%;">
      <b>Reviews</b>
    </h1>
    {rows.map((row) => (
      <div class="row">
        {row.map((review, i) => (
          <div
            class="col-md"
            style={
              row.length === 2 && i === 0
                ? "margin-left: 2.5%;"
                : "margin-left: 2.5%; margin-right: 2.5%;"
            }
          >
            <ReviewCard
              quote={review.quote}
              blankLines={review.blank_lines}
              caption={caption(review)}
              link={review.link}
              border={review === press[0] ? ".5rem" : ".6rem"}
              buttonStyle="margin: 10px;"
            />
          </div>
        ))}
      </div>
    ))}
    <div class="row">
      <div class="col-sm">
        <h3>{coaching_heading}</h3>
      </div>
    </div>
    <div class="row">
      {coachingColumns.map((column) => (
        <div class="col-md">
          {column.map((quote) => (
            <ReviewCard quote={[quote]} />
          ))}
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
