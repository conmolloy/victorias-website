---
/**
 * Headshots. All shoots come from src/content/headshots.yaml – to add one,
 * edit that file (README: "How to update the site"); this file is only the
 * layout.
 */
import { getEntry } from "astro:content";
import Credit from "../components/headshots/Credit.astro";
import ShootPhotos from "../components/headshots/ShootPhotos.astro";
import Lightbox from "../components/Lightbox.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const { shoots } = (await getEntry("headshots", "headshots"))!.data;
---

<BaseLayout
  title="Headshots – Victoria Adler"
  description="Headshots of actor Victoria Adler from 2023 and 2024, by Michael Shelford, Framed Duck Studio, David Yiu and Point Of You."
  path="/headshot"
  preloads={["cabin-700-latin.woff2", "roboto-400-latin.woff2"]}
>
  {shoots.map((shoot, i) => (
    <>
      <div class="container">
        {(i === 0 || shoot.year !== shoots[i - 1]!.year) && (
          <h1 class="text-center">{shoot.year}</h1>
        )}
        <ShootPhotos shoot={shoot} eager={i === 0} />
      </div>
      <Credit
        photographer={shoot.photographer}
        last={i === shoots.length - 1}
      />
    </>
  ))}
  <Lightbox />
</BaseLayout>
