---
/**
 * Headshots. All shoots come from src/content/headshots.yaml – to add one,
 * edit that file (README: "How to update the site"); this file is only the
 * layout.
 */
import { getEntry } from "astro:content";
import Credit from "../components/headshots/Credit.astro";
import ShootPhotos from "../components/headshots/ShootPhotos.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const { shoots } = (await getEntry("headshots", "headshots"))!.data;
const [first, ...rest] = shoots;
---

<BaseLayout
  title="Headshots – Victoria Adler"
  description="Headshots of actor Victoria Adler from 2023 and 2024, by Michael Shelford, Framed Duck Studio, David Yiu and Point Of You."
  path="/headshot"
  preloads={["cabin-700-latin.woff2", "roboto-400-latin.woff2"]}
>
  <div class="header-container">
    <section
      class="projects-clean"
      style="background: rgb(255,255,255);color: black;"
    >
      <div class="container">
        <div class="row header-new">
          <div class="intro"></div>
        </div>
      </div>
    </section>
  </div>

  {/*
    As on the original page: the first shoot at the top level, the others
    inside one more container – the 2nd shoot's rows directly, later shoots
    each in a container of their own (indented a little more).
  */}
  <div class="container">
    <h1 class="text-center">{first!.year}</h1>
    <ShootPhotos shoot={first!} eager />
  </div>
  <Credit photographer={first!.photographer} last={rest.length === 0} />

  {rest.length > 0 && (
    <div class="container">
      {rest.map((shoot, i) => {
        const newYear = shoot.year !== shoots[i]!.year;
        const last = i === rest.length - 1;
        return (
          <>
            {newYear && (
              <div class="container">
                <h1 class="text-center">{shoot.year}</h1>
              </div>
            )}
            {i === 0 ? (
              <ShootPhotos shoot={shoot} />
            ) : (
              <div class="container">
                <ShootPhotos shoot={shoot} />
              </div>
            )}
            <Credit photographer={shoot.photographer} last={last} />
          </>
        );
      })}
    </div>
  )}
</BaseLayout>
