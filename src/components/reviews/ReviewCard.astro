---
/**
 * A review card: the quote, who wrote it where and when, and a "Read Review"
 * link. Without `by`/`publication`/`link` (coaching reviews) it's just the quote.
 */
interface Props {
  quote: string[];
  /** [before, after]: empty lines that make a short quote's card taller */
  blankLines?: [number, number] | undefined;
  /** caption: who, where, when (leave out for an anonymous quote) */
  caption?: string | undefined;
  link?: string | undefined;
  /** thicker left border (the reviews page's cards, except the first) */
  thick?: boolean;
  /** margin all round the "Read Review" button (reviews page) */
  spacedButton?: boolean;
}

const {
  quote,
  blankLines,
  caption,
  link,
  thick = false,
  spacedButton = false,
} = Astro.props;
const [before, after] = blankLines ?? [0, 0];
const lines = (n: number) => Array.from({ length: n });
---

<figure class:list={["review-card", { thick }]}>
  <blockquote class="blockquote">
    {quote.map((paragraph, i) => (
      <p>
        {i === 0 && lines(before).map(() => <br />)}
        <Fragment set:html={paragraph} />
        {i === quote.length - 1 && lines(after).map(() => <br />)}
      </p>
    ))}
  </blockquote>
  {caption && (
    <figcaption class="blockquote-footer mb-0 fst-italic">
      {/* the gap after the "—" is its non-breaking space plus this space */}{" "}
      {caption}
    </figcaption>
  )}
  {link && (
    <a href={link} class:list={["btn btn-review", { spaced: spacedButton }]}>
      Read Review
    </a>
  )}
</figure>
