---
/**
 * Fixed top navbar (Bootstrap 5 / Grayscale theme). Collapses into the
 * hamburger menu below 768px (Bootstrap's collapse plugin) and shrinks after
 * scrolling (the script at the end).
 *
 * "Home" is always the highlighted (active) link, on every page, as on the
 * original site. Links have no ".html": the server maps /resume to resume.html.
 */
interface Props {
  /** "#" on home and reviews, "/" on the other pages */
  brandHref: string;
}

import { PROFILES } from "../lib/site";

const { brandHref } = Astro.props;

const pages = [
  { href: "resume", label: "CV" },
  { href: "showreel", label: "Showreel" },
  { href: "headshot", label: "Portfolio" },
  { href: "gallery", label: "Gallery" },
  { href: "reviews", label: "Reviews" },
];
---

<nav class="navbar navbar-light navbar-expand-md fixed-top" id="mainNav">
  <div class="container">
    <a
      class="navbar-brand js-scroll-trigger"
      href={brandHref}
      style="font-family: Roboto, sans-serif;"
    >
      Victoria Adler
    </a>
    <button
      data-bs-toggle="collapse"
      class="navbar-toggler"
      data-bs-target="#navbarResponsive"
      aria-controls="navbarResponsive"
      aria-expanded="false"
      type="button"
      aria-label="Menu"
    >
      <i class="fa fa-bars"></i>
    </button>
    <div class="collapse navbar-collapse" id="navbarResponsive">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item nav-link js-scroll-trigger">
          <a
            class="nav-link active js-scroll-trigger"
            href="/"
            style="background: rgba(255,255,255,0);font-family: Roboto, sans-serif;"
          >
            Home
          </a>
        </li>
        {pages.map(({ href, label }) => (
          <li class="nav-item nav-link js-scroll-trigger">
            <a
              class="nav-link js-scroll-trigger"
              href={href}
              style="font-family: Roboto, sans-serif;"
            >
              {label}
            </a>
          </li>
        ))}
        <div class="flex-container">
          {PROFILES.map(({ href, name, logo }) => (
            <li class="nav-item nav-link">
              <a class="nav-link" href={href}>
                <img class="logo" src={logo} alt={name} />
              </a>
            </li>
          ))}
        </div>
      </ul>
    </div>
  </div>
</nav>

<script>
  import Collapse from "bootstrap/js/dist/collapse.js";

  const nav = document.getElementById("mainNav")!;
  const menu = document.getElementById("navbarResponsive")!;

  // close the phone menu when one of its links is clicked
  for (const link of document.querySelectorAll(".js-scroll-trigger")) {
    link.addEventListener("click", () => {
      Collapse.getOrCreateInstance(menu, { toggle: false }).hide();
    });
  }

  // shrink the navbar (smaller, black background) once the page is scrolled
  const shrink = () =>
    nav.classList.toggle("navbar-shrink", window.scrollY > 50);
  shrink();
  window.addEventListener("scroll", shrink, { passive: true });
</script>
