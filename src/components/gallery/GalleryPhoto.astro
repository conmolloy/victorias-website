---
/**
 * A gallery photo with srcset/sizes so browsers download only the size they
 * show. It links to the full-size photo, which the lightbox
 * (components/Lightbox.astro) opens on the page; without JavaScript the
 * link simply opens the photo.
 */
import { photo as photoAttrs } from "../../lib/photos";

interface Props {
  photo: { file: string; alt: string };
  /** extra class: "dance" (dance + misc photos) or "certificate" */
  kind?: "dance" | "certificate";
  /** first screen: load straight away instead of when scrolled near */
  eager?: boolean;
  /** shown in the lightbox above the photo's description, e.g. "Macbeth – Macduff" */
  caption?: string | undefined;
}

const { photo, kind, eager = false, caption } = Astro.props;
const { src, srcset, width, height } = await photoAttrs(photo.file);

// widths each photo is shown at, as measured on the page (3 photos a row;
// certificates 2): fixed column widths from 576px up, then the screen width
// minus the gutters (the lightbox shows the full-size photo)
const sizes =
  kind === "certificate"
    ? "(min-width: 1200px) 510px, (min-width: 992px) 420px, (min-width: 768px) 300px, (min-width: 576px) 210px, calc((100vw - 120px) / 2)"
    : "(min-width: 1200px) 330px, (min-width: 992px) 270px, (min-width: 768px) 190px, (min-width: 576px) 130px, calc((100vw - 150px) / 3)";
---

<a class="lightbox-link" href={src} data-caption={caption}>
  <img
    alt={photo.alt}
    loading={eager ? undefined : "lazy"}
    decoding="async"
    class:list={[kind, "img-fluid"]}
    src={src}
    srcset={srcset}
    sizes={sizes}
    width={width}
    height={height}
  />
</a>
