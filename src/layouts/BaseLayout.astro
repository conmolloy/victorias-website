---
/**
 * Page shell shared by every page: <head> (meta, search/link-preview tags,
 * font preloads, stylesheets, deferred Google Tag Manager), the GTM noscript
 * iframe, the navbar, and the script at the end of <body> (smooth scrolling
 * for in-page links; the navbar has its own script).
 *
 * Local CSS/JS links go through v() so they carry a content-hash ?v=
 * (browsers cache CSS/JS for 30 days).
 */
import GoogleTagManager from "../components/GoogleTagManager.astro";
import Navbar from "../components/Navbar.astro";
import SeoTags from "../components/SeoTags.astro";
import { v } from "../lib/asset";
import type { PAGES } from "../lib/site";

interface Props {
  /** <title>, also the headline of link previews */
  title: string;
  /** one or two sentences for search results and link previews */
  description: string;
  /** the page's canonical (extension-less) path, e.g. "/gallery" */
  path: (typeof PAGES)[number];
  /** link-preview type: "profile" on home, "website" (default) elsewhere */
  ogType?: "profile" | "website";
  /** font files in assets/fonts/ to <link rel="preload">, in order (the ones the first screen uses) */
  preloads: string[];
  /** home only: load font-outfit.css */
  outfit?: boolean;
  /** navbar brand link: "#" on home and reviews, "/" elsewhere */
  brandHref?: string;
  bodyId?: string;
  bodyClass?: string;
}

const {
  title,
  description,
  path,
  ogType,
  preloads,
  outfit = false,
  brandHref = "/",
  bodyId,
  bodyClass,
} = Astro.props;
---

<html lang="en">
  <head>
    <GoogleTagManager />
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, shrink-to-fit=no"
    />
    <link rel="shortcut icon" type="image/x-icon" href="favicon.ico" />
    <title>{title}</title>
    <SeoTags
      title={title}
      description={description}
      path={path}
      ogType={ogType}
    />
    <slot name="head-scripts" />
    {preloads.map((font) => (
      <link
        rel="preload"
        href={`assets/fonts/${font}`}
        as="font"
        type="font/woff2"
        crossorigin
      />
    ))}
    <link rel="stylesheet" href={v("assets/css/fonts.css")} />
    <link rel="stylesheet" href={v("assets/bootstrap/css/bootstrap.min.css")} />
    {outfit && <link rel="stylesheet" href={v("assets/css/font-outfit.css")} />}
    <link rel="stylesheet" href={v("assets/css/font-roboto.css")} />
    <link rel="stylesheet" href={v("assets/fonts/font-awesome.min.css")} />
    <link rel="stylesheet" href={v("assets/css/Projects-Clean.css")} />
    <slot name="head" />
  </head>

  <body id={bodyId} class={bodyClass}>
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-NXB648G"
        title="Google Tag Manager"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->
    <Navbar brandHref={brandHref} />
    <slot />
    <slot name="scripts" />
    <script>
      // In-page links (the gallery's section buttons) scroll smoothly to
      // their section in 1s, leaving 48px for the navbar, instead of jumping.
      const DURATION = 1000;
      const NAVBAR = 48;
      const swing = (p: number) => 0.5 - Math.cos(p * Math.PI) / 2;

      function scrollToY(y: number) {
        const from = window.scrollY;
        const start = performance.now();
        const step = (now: number) => {
          const p = Math.min((now - start) / DURATION, 1);
          window.scrollTo(0, from + (y - from) * swing(p));
          if (p < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      }

      for (const link of document.querySelectorAll<HTMLAnchorElement>(
        'a.js-scroll-trigger[href*="#"]:not([href="#"])',
      )) {
        link.addEventListener("click", (event) => {
          if (
            link.pathname.replace(/^\//, "") !==
              location.pathname.replace(/^\//, "") ||
            link.hostname !== location.hostname
          )
            return;
          const id = decodeURIComponent(link.hash.slice(1));
          const target =
            document.getElementById(id) ?? document.getElementsByName(id)[0];
          if (!target) return;
          event.preventDefault();
          scrollToY(
            target.getBoundingClientRect().top + window.scrollY - NAVBAR,
          );
        });
      }
    </script>
  </body>
</html>
